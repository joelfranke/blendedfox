{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blendedfox",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
